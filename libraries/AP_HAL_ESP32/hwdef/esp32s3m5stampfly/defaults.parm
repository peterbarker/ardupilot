# drone specific settings
FRAME_CLASS 1
MOT_PWM_TYPE 3 # brushed motor PWM
RC_SPEED 32000 # as fast as ardupilot supports (more would be nice)
LOG_BACKEND_TYPE 2 # mavlink logging
ARMING_SKIPCHK 1024 # disable logging check (in the event log rx is not up)
LOG_DISARMED 1
SCHED_LOOP_RATE 150 # flash won't go faster :(
INITIAL_MODE 2 # ALT_HOLD: the baro and downward rangefinder hold height

# mavlink RC control
FS_THR_ENABLE 0 # not wanted for mavlink control
RC1_MIN 1101 # avoid calibration needed warning
RC_OPTIONS 96 # ignore rpy stick positions during arming, nice for crap controllers

# tuning parameters from mission planner's wizard
ATC_ACC_P_MAX 2002
ATC_ACC_R_MAX 2002
ATC_ACC_Y_MAX 338
ATC_RAT_PIT_FLTD 67
ATC_RAT_PIT_FLTT 67
ATC_RAT_RLL_FLTD 67
ATC_RAT_RLL_FLTT 67
ATC_RAT_YAW_FLTD 0
ATC_RAT_YAW_FLTE 2
ATC_RAT_YAW_FLTT 67
INS_GYRO_FILTER 134
MOT_THST_EXPO 0.45

# battery monitoring settings
BATT_ARM_MAH    0
BATT_ARM_VOLT   0
BATT_CAPACITY   300
BATT_CHANNEL    2
BATT_CRT_MAH    0
BATT_CRT_VOLT   0
BATT_FS_CRT_ACT 0
BATT_FS_LOW_ACT 0
BATT_FS_VOLTSRC 0
BATT_I2C_ADDR   64
BATT_I2C_BUS    0
BATT_LOW_MAH    0
BATT_LOW_TIMER  10
BATT_LOW_VOLT   3.4
BATT_MONITOR    30
BATT_OPTIONS    0
BATT_SERIAL_NUM -1

# optical flow: the sensor is mounted turned 180 degrees from the board
FLOW_ORIENT_YAW 18000

# VL53L3CX rangefinders facing down and forward.  Both start at I2C
# address 0x29; their shutdown (XSHUT) pins are on GPIO 7 (down) and
# GPIO 9 (forward), so the forward one is moved to 0x2A at startup.
# They work with the VL53L1X driver in short distance mode, which
# reaches about 1.3m
RNGFND1_TYPE 28
RNGFND1_ADDR 41
RNGFND1_STOP_PIN 7
RNGFND1_MAX 1.3
RNGFND2_TYPE 28
RNGFND2_ADDR 42
RNGFND2_STOP_PIN 9
RNGFND2_MAX 1.3
RNGFND2_ORIENT 0

# use the forward rangefinder for avoidance: in Loiter stop 0.4m short of
# an obstacle, and in AltHold lean away from one closer than 1m
PRX1_TYPE 4
AVOID_MARGIN 0.4
AVOID_DIST_MAX 1.0
AVOID_BACKUP_SPD 0.3

# encoding: utf-8

# the file client is a host tool, so it is built on boards which are
# themselves built for the host


def build(bld):
    if bld.env.BOARD != 'sitl':
        return

    # the vehicle wraps malloc so that it can account for allocations,
    # and the vehicle library provides the wrapper.  This program links
    # none of that - it is libcanard and nothing else - so the flag has
    # no provider here, and on a coverage build libgcov's own calls to
    # malloc would fail to link.  Give the program an env of its own
    # with those flags taken out
    env = bld.env.derive()
    env.detach()
    env.LINKFLAGS = [f for f in env.LINKFLAGS if 'wrap' not in f]

    bld.ap_program(
        env=env,
        program_name='dronecan_file_client',
        program_groups=['tool'],
        use_legacy_defines=False,
        vehicle_binary=False,
        source=[
            'dronecan_file_client.cpp',
            bld.srcnode.find_resource('modules/DroneCAN/libcanard/canard.c'),
        ],
        includes=[
            bld.srcnode.find_dir('modules/DroneCAN/libcanard').abspath(),
        ],
        defines=['CANARD_ENABLE_CANFD=1'],
        use=[],
    )
